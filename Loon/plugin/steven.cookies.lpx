#!name=获取cookie合集
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/others/cookie.png
#!desc=获取成功后，关闭获取ck脚本，避免产生不必要的mitm

[Argument]
阿里云盘 = switch,false,tag=阿里云盘 Cookie
高德地图 = switch,false,tag=高德地图 Cookie
华住会 = switch,false,tag=华住会 Cookie
美团买菜 = switch,false,tag=美团买菜 Cookie
小蚕霸王餐 = switch,false,tag=小蚕霸王餐 Cookie
歪麦霸王餐 = switch,false,tag=歪麦霸王餐 Cookie
晓晓优选 = switch,false,tag=晓晓优选 Cookie
WPS = switch,false,tag=WPS Cookie

[Script]

# > 阿里云盘
request if ${url} ~= /^https:\/\/(auth|aliyundrive)\.alipan\.com\/v2\/account\/token/i then script("https://gist.githubusercontent.com/Sliverkiss/33800a98dcd029ba09f8b6fc6f0f5162/raw/aliyun.js") with requires_body=true, timeout=60, tag="阿里云盘", enable=${阿里云盘}

# > 高德地图
response if ${url} ~= /^https?:\/\/(m5(|-zb)|dache)\.amap\.com\/(ws\/yuece\/(act|openapi\/activity\/current)\/query|common\/(alipaymini|wxmini)\?_ENCRYPT=)/i then script("https://raw.githubusercontent.com/wf021325/qx/master/task/ampDache.js") with requires_body=true, timeout=60, tag="高德地图", enable=${高德地图}

# > 华住会
request if ${url} ~= /^https?:\/\/hweb-personalcenter\.huazhu\.com\/login\/autoLogin$/i then script("https://raw.githubusercontent.com/wf021325/qx/master/task/hzh.js") with requires_body=true, timeout=60, tag="华住会", enable=${华住会}

# > 美团买菜
request if ${url} ~= /^https?:\/\/mall\.meituan\.com\/api\/c\/mallcoin\/checkIn\/queryTaskListInfoV.\?/i then script("https://raw.githubusercontent.com/JoJoJotarou/myScript/master/script/meituan/mall.meituan.cookie.js") with timeout=60, tag="美团买菜", enable=${美团买菜}

# > 小蚕霸王餐
response if ${url} ~= /^https:\/\/gw\.xiaocantech\.com\/rpc/i then script("https://gist.githubusercontent.com/Sliverkiss/250a02315f0a2c99f42da3b3573375c8/raw/xcbwc.js") with requires_body=true, timeout=60, tag="小蚕霸王餐", enable=${小蚕霸王餐}

# > 歪麦霸王餐
request if ${url} ~= /^https:\/\/wmapp-api\.waimaimingtang\.com\/api\/api\/v2\/user\/api_user_info_one/i then script("https://gist.githubusercontent.com/Sliverkiss/49a9ffb2169a2becc33bf4fdbf6eb99a/raw/wmbwc.js") with requires_body=true, timeout=60, tag="歪麦霸王餐", enable=${歪麦霸王餐}

# > 晓晓优选
response if ${url} ~= /^https:\/\/xxyx-client-api\.xiaoxiaoyouxuan\.com\/my/i then script("https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/cookie/get_cookie.js") with requires_body=true, timeout=60, tag="晓晓优选", enable=${晓晓优选}

# > WPS Cookie
request if ${url} ~= /^https:\/\/personal-act\.wps\.cn\/activity-rubik\/activity\/page_info/i then script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/wps/wps.cookie.js") with timeout=60, tag="WPS Cookie", enable=${WPS}

[MITM]
hostname = auth.alipan.com, auth.aliyundrive.com, *.amap.com, passport.biligame.com, manga.bilibili.com, *.bilibili.com, hweb-personalcenter.huazhu.com, xxyx-client-api.xiaoxiaoyouxuan.com, wmapp-api.waimaimingtang.com, gw.xiaocantech.com, i.meituan.com, mall.meituan.com, promotion.waimai.meituan.com, personal-act.wps.cn
